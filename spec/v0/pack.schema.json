{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context.nanti.ai/spec/v0/pack.schema.json",
  "title": "OCL pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_kind",
    "schema_version",
    "pack_id",
    "release",
    "status",
    "scope",
    "entry_paths",
    "source_snapshots",
    "environment_snapshots",
    "fixture_reports",
    "verification_reports",
    "release_locks",
    "coverage"
  ],
  "properties": {
    "document_kind": {"const": "ocl.pack"},
    "schema_version": {"const": "0.1.0"},
    "pack_id": {"type": "string", "minLength": 1},
    "release": {"type": "string", "minLength": 1},
    "status": {"enum": ["experimental", "use_case_complete", "module_core", "module_extended", "deprecated"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["odoo_versions", "editions", "modules"],
      "properties": {
        "odoo_versions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "editions": {"type": "array", "minItems": 1, "items": {"enum": ["community", "enterprise"]}},
        "modules": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "entry_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "source_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"}
        }
      }
    },
    "environment_snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "role", "edition"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"},
          "role": {"enum": ["initial", "current", "final"]},
          "edition": {"enum": ["community", "enterprise"]}
        }
      }
    },
    "fixture_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "edition"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"},
          "edition": {"enum": ["community", "enterprise"]}
        }
      }
    },
    "review_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"}
        }
      }
    },
    "runtime_indexes": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"}
        }
      }
    },
    "verification_reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"}
        }
      }
    },
    "release_locks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "use_cases", "limitations"],
      "properties": {
        "label": {"type": "string"},
        "use_cases": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}

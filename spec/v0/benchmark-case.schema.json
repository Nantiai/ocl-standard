{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context.nanti.ai/spec/v0/benchmark-case.schema.json",
  "title": "OCL benchmark case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_kind",
    "schema_version",
    "case_id",
    "disclosure",
    "question",
    "intent",
    "scope",
    "allowed_operations",
    "expected_behavior",
    "ground_truth",
    "tags"
  ],
  "properties": {
    "document_kind": {"const": "ocl.benchmark_case"},
    "schema_version": {"const": "0.1.0"},
    "case_id": {"type": "string", "pattern": "^ocl-bench\\.[a-z0-9][a-z0-9_.-]*$"},
    "disclosure": {"enum": ["public", "private", "rotating"]},
    "question": {"type": "string", "minLength": 1},
    "intent": {"enum": ["interpret", "read", "metric", "write"]},
    "scope": {"type": "object", "minProperties": 1},
    "allowed_operations": {"type": "array", "items": {"type": "string"}},
    "expected_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_entry_ids", "must_clarify", "critical_failures", "rubric"],
      "properties": {
        "required_entry_ids": {"type": "array", "items": {"type": "string"}},
        "must_clarify": {"type": "array", "items": {"type": "string"}},
        "critical_failures": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "array", "items": {"type": "string"}},
        "rubric": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_concepts",
            "required_clarifications",
            "required_operations",
            "forbidden_operations",
            "required_warnings",
            "critical_failure_codes",
            "weights"
          ],
          "properties": {
            "required_concepts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "required_clarifications": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "required_operations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "forbidden_operations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "required_warnings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "critical_failure_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "weights": {
              "type": "object",
              "additionalProperties": false,
              "required": ["concepts", "clarifications", "operations", "warnings", "critical_safety"],
              "properties": {
                "concepts": {"type": "number", "minimum": 0},
                "clarifications": {"type": "number", "minimum": 0},
                "operations": {"type": "number", "minimum": 0},
                "warnings": {"type": "number", "minimum": 0},
                "critical_safety": {"type": "number", "minimum": 0}
              }
            }
          }
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method"],
      "properties": {
        "status": {"enum": ["planned", "fixture_ready", "sealed"]},
        "method": {"type": "string"},
        "fixture_id": {"type": "string"},
        "result_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sealed_at": {"type": "string", "format": "date-time"},
        "environment_snapshot_id": {"type": "string"},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["report_id", "fixture_sha256", "assertion_ids"],
            "properties": {
              "report_id": {"type": "string"},
              "fixture_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "assertion_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}
            }
          }
        }
      }
    },
    "tags": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
  }
}
